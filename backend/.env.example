# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/carbon_tracker

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# AWS S3 (Optional - leave empty to use local storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=carbon-tracker-uploads

# Azure Computer Vision (multiple keys for rotation)
AZURE_CV_KEY_1=your_azure_cv_key_1
AZURE_CV_ENDPOINT_1=https://your-resource-1.cognitiveservices.azure.com/
AZURE_CV_KEY_2=your_azure_cv_key_2
AZURE_CV_ENDPOINT_2=https://your-resource-2.cognitiveservices.azure.com/
AZURE_CV_KEY_3=your_azure_cv_key_3
AZURE_CV_ENDPOINT_3=https://your-resource-3.cognitiveservices.azure.com/

# OCR.space (fallback)
OCR_SPACE_API_KEY=K81659123788957

# OpenAI Vision (OCR + parsing in one - BEST quality)
# Get your key at: https://platform.openai.com/api-keys
# Cost: ~$0.38 per 1000 requests (gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o-mini

# Google Gemini AI (optional fallback)
# FREE tier (1500 requests/day): https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ENABLED=false
